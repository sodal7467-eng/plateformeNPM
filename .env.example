# =======================================================
# Configuration de l'application
# Copier ce fichier en .env et adapter les valeurs.
# Ne JAMAIS commiter le fichier .env réel.
# =======================================================

# --- Environnement ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://exemple.com

# --- Base de données ---
DB_HOST=localhost
DB_NAME=quincaillerie_npm
DB_USER=root
DB_PASSWORD=

# --- Sécurité ---
# Nombre max de tentatives de connexion avant blocage (par IP)
LOGIN_MAX_ATTEMPTS=5
# Durée du blocage en minutes
LOGIN_LOCKOUT_MINUTES=15
# Durée de validité d'un lien de réinitialisation (minutes)
RESET_TOKEN_MINUTES=30

# --- Email (notifications client) ---
# Gmail : créer un « mot de passe d'application » sur
# https://myaccount.google.com/apppasswords (validation en 2 étapes requise)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=NPM Quincaillerie
